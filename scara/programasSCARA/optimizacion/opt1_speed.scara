PROGRAM opt1_speed
# Optimizacion: SPEED consecutivo con el mismo valor se elimina
# Se esperan 3 instrucciones eliminadas del bytecode inicial
# Coordenadas validas: sqrt(x^2+y^2) en [50, 350]
POINT inicio    = 100 100 0
POINT almacen   = 200 150 0
POINT entrega   = 280 150 0
SPEED 70
SPEED 70
OPEN
MOVE almacen
CLOSE
WAIT 1
SPEED 90
SPEED 90
SPEED 90
MOVE entrega
OPEN
HOME
END
