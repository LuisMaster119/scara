PROGRAM opt1_speed
# Optimizacion: SPEED consecutivo con el mismo valor se elimina
# Se esperan 3 instrucciones eliminadas del bytecode inicial
POINT inicio    = 0   0   0
POINT almacen   = 200 150 0
POINT entrega   = 400 100 0
SPEED 70
SPEED 70
OPEN
MOVE almacen
CLOSE
WAIT 1
SPEED 90
SPEED 90
SPEED 90
MOVE entrega
OPEN
HOME
END
