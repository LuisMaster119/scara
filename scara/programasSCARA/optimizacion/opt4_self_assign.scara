PROGRAM opt4_self_assign
# Optimizacion: asignacion de variable a si misma se elimina (x = x)
# Se esperan 2 instrucciones eliminadas del bytecode inicial
VAR contador   = 10
VAR velocidad  = 50
POINT meta     = 250 180 0
contador  = contador
velocidad = velocidad
SPEED velocidad
MOVE meta
CLOSE
WAIT 1
OPEN
HOME
END
