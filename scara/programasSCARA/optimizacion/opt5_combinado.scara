PROGRAM opt5_combinado
# Combina todos los pases del optimizador SCARA:
#   - SPEED duplicado    (2 eliminadas)
#   - OPEN/CLOSE duplic. (3 eliminadas)
#   - Plegado constantes (ciclos = 2+1 => 3, pausa = 4-2 => 2 en bytecode)
#   - Auto-asignacion    (1 eliminada: ciclos = ciclos)
# Total esperado: 6 instrucciones eliminadas
VAR ciclos = 0
VAR pausa  = 0
POINT recogida = 120 150 0
POINT deposito = 250 150 0
SPEED 60
SPEED 60
OPEN
OPEN
ciclos = 2 + 1
pausa  = 4 - 2
ciclos = ciclos
MOVE recogida
CLOSE
CLOSE
WAIT 2
SPEED 80
SPEED 80
MOVE deposito
OPEN
OPEN
HOME
END
