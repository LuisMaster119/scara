PROGRAM opt5_combinado
# Combina todos los pases del optimizador SCARA:
#   - SPEED duplicado    (2 eliminadas)
#   - OPEN/CLOSE duplic. (3 eliminadas)
#   - Plegado constantes (valores pre-calculados)
#   - Auto-asignacion    (1 eliminada)
# Total esperado: 6 instrucciones eliminadas
# Coordenadas validas: sqrt(x^2+y^2) en [50, 350]
VAR ciclos = 0
VAR pausa  = 0
POINT recogida = 120 150 0
POINT deposito = 250 150 0
SPEED 60
SPEED 60
OPEN
OPEN
ciclos = 2 + 1
pausa  = 4 - 2
ciclos = ciclos
MOVE recogida
CLOSE
CLOSE
WAIT pausa
SPEED 80
SPEED 80
MOVE deposito
OPEN
OPEN
HOME
END